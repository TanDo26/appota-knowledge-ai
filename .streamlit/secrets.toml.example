# Copy this file to .streamlit/secrets.toml (git-ignored) and fill in your own values.
# On Streamlit Community Cloud, paste the same keys into App settings → Secrets.

GEMINI_API_KEY = "paste-your-key-here"

# One or more models, comma-separated, tried in order (retired or overloaded ones are skipped).
# Free-tier model names change; gemini-2.5-flash is no longer open to new keys (checked 14/10/2026).
GEMINI_MODEL = "gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.8-flash"
